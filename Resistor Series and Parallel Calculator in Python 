Resistor Series and Parallel Calculator

print("Resistor Series and Parallel Calculator")
print("---------------------------------------")

print("1. Series Resistance")
print("2. Parallel Resistance")

choice = int(input("Enter your choice (1 or 2): "))

r1 = float(input("Enter R1 (Ω): "))
r2 = float(input("Enter R2 (Ω): "))
r3 = float(input("Enter R3 (Ω): "))

if choice == 1:
# Series: R = R1 + R2 + R3
total = r1 + r2 + r3
print("Total Series Resistance =", total, "Ω")

elif choice == 2:
# Parallel: 1/R = 1/R1 + 1/R2 + 1/R3
total = 1 / ((1 / r1) + (1 / r2) + (1 / r3))
print("Total Parallel Resistance =", total, "Ω")

else:
print("Invalid choice!")